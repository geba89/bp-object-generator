  <stage stageid="19a7a5fb-a019-4c80-8eab-6f3398bee86a" name="TPL Select From List" type="SubSheetInfo"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><narrative>Finds the option with the text I_Select and selects it by its position (option={n}).</narrative><display x="-195" y="-105" w="150" h="90" /></stage>
  <stage stageid="b876c293-38d1-4940-b158-d1cfc3e3cff9" name="Start" type="Start"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" /><inputs><input type="text" name="I_Title" narrative="" stage="I_Title" /><input type="text" name="I_Titles" narrative="" stage="I_Titles" /><input type="text" name="I_Select" narrative="" stage="I_Select" /></inputs><onsuccess>2d28d368-ee96-4af5-a055-9debf7a29d31</onsuccess></stage>
  <stage stageid="2d28d368-ee96-4af5-a055-9debf7a29d31" name="Option in list?" type="Action"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" /><inputs><input type="number" name="I_Attempts" expr="3" /><input type="text" name="I_PageTitle" expr="[I_Title]" /><input type="text" name="I_PageTitles" expr="[I_Titles]" /><input type="text" name="I_XPath" expr="&quot;{{XPATH}}&quot; &amp; &quot;/option[translate(normalize-space(), 'ABCDEFGHIJKLMNOPQRSTUVWXYZĄĆĘŁŃÓŚŹŻ', 'abcdefghijklmnopqrstuvwxyząćęłńóśźż')=&quot;&quot;&quot; &amp; Lower(Replace(Replace(Replace(Trim([I_Select]), &quot;  &quot;, &quot; &quot;), &quot;  &quot;, &quot; &quot;), &quot;  &quot;, &quot; &quot;)) &amp; &quot;&quot;&quot;]&quot;" /><input type="flag" name="I_Click" expr="False" /><input type="flag" name="I_Read" expr="True" /><input type="flag" name="I_Write" expr="False" /><input type="text" name="I_Text" expr="&quot;&quot;" /><input type="text" name="I_Select" expr="&quot;&quot;" /></inputs><outputs><output type="text" name="O_Text" stage="Option Text" /></outputs><onsuccess>25c57db6-53f2-4831-a75a-a47575a001de</onsuccess><resource object="Web Browser" action="Dynamic Action" /></stage>
  <stage stageid="25c57db6-53f2-4831-a75a-a47575a001de" name="First option" type="Calculation"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><display x="15" y="15" w="90" h="30" /><calculation expression="1" stage="Position" /><onsuccess>b17a77ba-6c25-43cf-b52c-8c2aa0584b17</onsuccess></stage>
  <stage stageid="b17a77ba-6c25-43cf-b52c-8c2aa0584b17" name="Read option" type="Action"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><loginhibit onsuccess="true" /><display x="15" y="75" /><inputs><input type="number" name="I_Attempts" expr="1" /><input type="text" name="I_PageTitle" expr="[I_Title]" /><input type="text" name="I_PageTitles" expr="[I_Titles]" /><input type="text" name="I_XPath" expr="&quot;{{XPATH}}&quot; &amp; &quot;/option[&quot; &amp; [Position] &amp; &quot;]&quot;" /><input type="flag" name="I_Click" expr="False" /><input type="flag" name="I_Read" expr="True" /><input type="flag" name="I_Write" expr="False" /><input type="text" name="I_Text" expr="&quot;&quot;" /><input type="text" name="I_Select" expr="&quot;&quot;" /></inputs><outputs><output type="text" name="O_Text" stage="Option Text" /></outputs><onsuccess>75f4be2b-0cbc-4845-809a-52ee32c53498</onsuccess><resource object="Web Browser" action="Dynamic Action" /></stage>
  <stage stageid="75f4be2b-0cbc-4845-809a-52ee32c53498" name="This one?" type="Decision"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><display x="15" y="135" w="90" h="60" /><decision expression="Lower(Replace(Replace(Replace(Trim([Option Text]), &quot;  &quot;, &quot; &quot;), &quot;  &quot;, &quot; &quot;), &quot;  &quot;, &quot; &quot;)) = Lower(Replace(Replace(Replace(Trim([I_Select]), &quot;  &quot;, &quot; &quot;), &quot;  &quot;, &quot; &quot;), &quot;  &quot;, &quot; &quot;))" /><ontrue>bf9c1e42-81b7-4c9a-8632-c797abf82c33</ontrue><onfalse>9191076f-8e9e-404e-936a-acb2359ed787</onfalse></stage>
  <stage stageid="bf9c1e42-81b7-4c9a-8632-c797abf82c33" name="Select by position" type="Action"><subsheetid>a232e505-828a-4c95-8610-d73af9837240</subsheetid><loginhibit onsuccess="true" /><display x="15" y="195" /><inputs><input type="number" name="I_Attempts" expr="3" /><input type="text" name="I_PageTitle" expr="[I_Title]" /><input type="text" name="I_PageTitles" expr="[I_Titles]" /><input type="text" name="I_XPath" expr="&quot;{{XPATH}}&quot;" /><input type="flag" name="I_Click" expr="False" /><input type="flag" name="I_Read" expr="False" /><input type="flag" name="I_Write" expr="False" /><input type="text" name="I_Text" expr="&quot;&quot;" /><input type="text" name="I_Select" expr="&quot;option=&quot; &amp; [Position]" /></inputs><onsuccess>45c54cc5-64d3-4f1d-b814-43c5eaf545d1</onsuccess><resource object="Web Browser" action="Dynamic Action" /></stage>
