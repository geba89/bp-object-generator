  <stage stageid="5a0af89e-40bc-4a03-810e-b738021a03e7" name="TPL Read Table" type="SubSheetInfo"><subsheetid>1283b35b-b2e4-4102-afa7-28dfa126b864</subsheetid><narrative>Reads the table into a collection. The first row gives the column names (local &quot;Headers In First Row&quot;).</narrative><display x="-195" y="-105" w="150" h="90" /></stage>
  <stage stageid="766d8777-12e8-4389-8ac0-05753dfa3a11" name="Start" type="Start"><subsheetid>1283b35b-b2e4-4102-afa7-28dfa126b864</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" /><inputs><input type="text" name="I_Title" narrative="" stage="I_Title" /><input type="text" name="I_Titles" narrative="" stage="I_Titles" /></inputs><onsuccess>2de7fe0e-a392-4181-b64d-bff5a11deb17</onsuccess></stage>
  <stage stageid="2de7fe0e-a392-4181-b64d-bff5a11deb17" name="Read table text" type="Action"><subsheetid>1283b35b-b2e4-4102-afa7-28dfa126b864</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" /><inputs><input type="number" name="I_Attempts" expr="3" /><input type="text" name="I_PageTitle" expr="[I_Title]" /><input type="text" name="I_PageTitles" expr="[I_Titles]" /><input type="text" name="I_XPath" expr="&quot;{{XPATH}}&quot;" /><input type="flag" name="I_Click" expr="False" /><input type="flag" name="I_Read" expr="True" /><input type="flag" name="I_Write" expr="False" /><input type="text" name="I_Text" expr="&quot;&quot;" /><input type="text" name="I_Select" expr="&quot;&quot;" /></inputs><outputs><output type="text" name="O_Text" stage="Table Text" /></outputs><onsuccess>786e4afa-003d-49b8-bed9-574e40d6387e</onsuccess><resource object="Web Browser" action="Dynamic Action" /></stage>
  <stage stageid="786e4afa-003d-49b8-bed9-574e40d6387e" name="Text to collection" type="Code"><subsheetid>1283b35b-b2e4-4102-afa7-28dfa126b864</subsheetid><loginhibit onsuccess="true" /><display x="15" y="30" /><inputs><input type="text" name="Text" expr="[Table Text]" /><input type="flag" name="Headers" expr="[Headers In First Row]" /></inputs><outputs><output type="collection" name="Table" stage="O_Table" /></outputs><onsuccess>ff91720a-b911-4df3-9af1-d6a3c6c25553</onsuccess><code><![CDATA[// Turns the text of a table into a collection.
// Chrome gives a table's text with one row per line and the cells separated by tabs.
// Inputs: Text (text), Headers (flag: first row = column names). Output: Table (collection).
Table = new DataTable();
string[] lines = (Text ?? "").Replace("\r", "").Split('\n');
var rows = new System.Collections.Generic.List<string>();
foreach (string line in lines)
	if (line.Trim() != "") rows.Add(line);
if (rows.Count == 0) return;

// The widest row decides how many columns the table has. Short lines BEFORE the first
// full row are a caption or title above the table: they are skipped.
Func<string, int> tabs = (s) => s.Split('\t').Length - 1;
int width = 0;
foreach (string row in rows) width = Math.Max(width, tabs(row) + 1);
while (rows.Count > 1 && tabs(rows[0]) < width - 1) rows.RemoveAt(0);

// A cell with a line break splits its row in two short lines ("x<TAB>y1" + "y2<TAB>z"):
// join two short lines when together they make exactly one row
var joined = new System.Collections.Generic.List<string>();
for (int i = 0; i < rows.Count; i++)
{
	string row = rows[i];
	while (i > 0 && tabs(row) < width - 1 && i + 1 < rows.Count
		&& tabs(rows[i + 1]) < width - 1 && tabs(row) + tabs(rows[i + 1]) <= width - 1)
	{
		row = row + "\n" + rows[i + 1];
		i++;
	}
	joined.Add(row);
}

for (int i = 0; i < joined.Count; i++)
{
	string[] cells = joined[i].Split('\t');
	if (i == 0)
	{
		// Column names: the header texts, or "Column 1", "Column 2"...; duplicates get " 2"
		for (int c = 0; c < width; c++)
		{
			string name = (Headers && c < cells.Length) ? cells[c].Trim() : "";
			if (name == "") name = "Column " + (c + 1);
			string unique = name;
			for (int n = 2; Table.Columns.Contains(unique); n++) unique = name + " " + n;
			Table.Columns.Add(unique, typeof(string));
		}
		if (Headers) continue;
	}
	// A row with more cells than the header (rare) keeps the extra text in the last column
	DataRow r = Table.NewRow();
	for (int c = 0; c < width; c++) r[c] = ""; // missing cells are empty text, not null
	for (int c = 0; c < cells.Length; c++)
	{
		int col = Math.Min(c, width - 1);
		string v = cells[c].Trim();
		r[col] = (c >= width && r[col].ToString() != "") ? r[col] + " " + v : v;
	}
	Table.Rows.Add(r);
}]]></code></stage>
